# IAM/ITSM 桩接线片段（追加到 deploy/local/bkenv.properties 末尾）
# deploy/local/bkenv.properties 被 .gitignore 忽略，故以本文件作为可提交的模板。
# 后端（容器网内）→ 桩；浏览器（宿主机）→ 8081 映射。必须位于文件末尾以覆盖前面的空值声明。
BK_CI_AUTH_PROVIDER=rbac
BK_CI_IAM_APIGW_URL=http://iam-stub:8080
BK_CI_ITSM_APIGW_URL=http://iam-stub:8080
BK_CI_IAM_SYSTEM_ID=bk_ci_rbac
BK_CI_IAM_MIGRATE_TOKEN=stub-token
BK_CI_IAM_URL_PREFIX=http://localhost:8081/iam-stub
BK_CI_ITSM_URL_PREFIX=http://localhost:8081/itsm-stub
